#include <WebServer.h>
#include "DHT.h"

// ====== CONFIGURACIÓN ======
#define DHTPIN 4
#define DHTTYPE DHT22

#define SOIL_PIN 34

DHT dht(DHTPIN, DHTTYPE);
WebServer server(80);

// WiFi de Wokwi
const char* ssid = "Wokwi-GUEST";
const char* password = "";

